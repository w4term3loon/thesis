+#ifdef CONFIG_ARM64_MORELLO
+static void ringbuf_init_authority(struct bpf_ringbuf_map *map)
+{
+	void * __capability cap;
+	u64 length = 2ULL * map->map.max_entries;
+	unsigned long base = (unsigned long)map->rb->data;
+	cheri_perms_t perms = CHERI_PERM_GLOBAL | CHERI_PERM_LOAD | CHERI_PERM_STORE;
+
+	if (map->map.map_type != BPF_MAP_TYPE_RINGBUF)
+		return;
+	/* The allocator supplies the contiguous virtual extent of both aliases. */
+	cap = cheri_address_set(cheri_ddc_get(), base);
+	cap = cheri_bounds_set_exact(cap, length);
+	cap = cheri_perms_and(cap, perms);
+	if (!cheri_tag_get(cap) || cheri_base_get(cap) != base ||
+	    cheri_length_get(cap) != length || cheri_perms_get(cap) != perms)
+		return;
+	map->storage = kmalloc(sizeof(*map->storage), GFP_KERNEL_ACCOUNT);
+	if (!map->storage)
+		return;
+	*map->storage = cap;
+	pr_info("BPF_RING_ROOT storage_bytes=%llu aliases=2 tag=1 read=1 write=1 exec=0 load_cap=0 store_cap=0\n",
+		length);
+}
