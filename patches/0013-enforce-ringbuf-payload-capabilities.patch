+#ifdef CONFIG_ARM64_MORELLO
+/* One reservation per invocation. The private active capability is the
+ * authority for commit: never find a header from an unchecked BPF pointer.
+ * Existing verifier reference/lifetime rules still apply; no revocation.
+ */
+void * __capability bpf_ringbuf_cap(struct bpf_cap_context *ctx,
+		unsigned long argument, void * __capability supplied, unsigned long op)
+{
+	const struct bpf_ringbuf_map *map = container_of(ctx->map, struct bpf_ringbuf_map, map);
+	void * __capability parent;
+	void * __capability cap;
+	struct bpf_ringbuf_hdr *hdr;
+	void *sample;
+	u32 size;
+
+	if (op == BPF_FUNC_ringbuf_reserve) {
+		if (argument != BPF_CAP_RINGBUF_SIZE || ctx->active)
+			goto reject;
+		sample = __bpf_ringbuf_reserve(map->rb, argument);
+		if (!sample)
+			return NULL;
+		hdr = sample - BPF_RINGBUF_HDR_SZ;
+		size = READ_ONCE(hdr->len) & ~(BPF_RINGBUF_BUSY_BIT | BPF_RINGBUF_DISCARD_BIT);
+		parent = bpf_ringbuf_storage_cap(ctx->map);
+		cap = cheri_address_set(parent, (unsigned long)sample);
+		cap = cheri_bounds_set_exact(cap, size);
+		if (size != BPF_CAP_RINGBUF_SIZE || !cheri_tag_get(cap) ||
+		    cheri_base_get(cap) != (unsigned long)sample || cheri_length_get(cap) != size) {
+			bpf_ringbuf_commit(sample, BPF_RB_NO_WAKEUP, true);
+			pr_warn("BPF_RING_GATE rejected=inexact_reservation\n");
+			return NULL;
+		}
+		ctx->active = cap;
+		if ((unsigned long)sample - (unsigned long)map->rb->data + size > ctx->map->max_entries)
+			pr_info("BPF_RING_VALUE length=%u tag=1 wrap=1\n", size);
+		return cap;
+	}
+	if ((op != BPF_FUNC_ringbuf_submit && op != BPF_FUNC_ringbuf_discard) ||
+	    argument || !cheri_tag_get(ctx->active) ||
+	    !cheri_is_equal_exact(supplied, ctx->active))
+		goto reject;
+	sample = (void *)cheri_address_get(ctx->active);
+	bpf_ringbuf_commit(sample, 0, op == BPF_FUNC_ringbuf_discard);
+	ctx->active = NULL;
+	return NULL;
+reject:
+	/* Fail closed and discard only our recorded reservation, if any. */
+	pr_warn("BPF_RING_GATE rejected=reservation_contract\n");
+	if (cheri_tag_get(ctx->active))
+		bpf_ringbuf_commit((void *)cheri_address_get(ctx->active), BPF_RB_NO_WAKEUP, true);
+	ctx->active = NULL;
+	return NULL;
+}
+#endif
