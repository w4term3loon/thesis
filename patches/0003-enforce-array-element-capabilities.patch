  * >0 - successfully JITed a 16-byte eBPF instruction.
  * <0 - failed to JIT.
  */
+static int emit_array_cap_insn(const struct bpf_insn *insn, u8 kind,
+			       struct jit_ctx *ctx)
+{
+	u8 dst = bpf2a64[insn->dst_reg], src = bpf2a64[insn->src_reg];
+	u8 tmp = bpf2a64[TMP_REG_1], tmp2 = bpf2a64[TMP_REG_2];
+	bool load = kind == BPF_OBJECT_ARRAY_LOAD;
+	u8 base = load ? src : dst, value = load ? dst : src;
+	s64 offset;
+	int size;
+
+	switch (kind) {
+	case BPF_OBJECT_ARRAY_VALUE_RESULT:
+		emit(A64_ADD(1, dst, dst, src), ctx);
+		/* The gate returns only the child in C7 (BPF R0). */
+		emit(M64_BLR(A64_R(23)), ctx);
+		emit(M64_MOV(A64_LR, A64_R(24)), ctx);
+		return 0;
+	case BPF_OBJECT_ARRAY_COPY:
+		emit(M64_MOV(dst, src), ctx);
+		return 0;
+	case BPF_OBJECT_ARRAY_OFFSET:
+		offset = insn->imm;
+		if (BPF_OP(insn->code) == BPF_SUB)
+			offset = -offset;
+		emit_a64_mov_i64(tmp, offset, ctx);
+		emit(M64_ADD(dst, dst, tmp), ctx);
+		return 0;
+	case BPF_OBJECT_ARRAY_LOAD:
+	case BPF_OBJECT_ARRAY_STORE:
+		size = bpf_size_to_bytes(BPF_SIZE(insn->code));
+		if (size < 0)
+			return -EINVAL;
+		/* Never choose an integer/RDDC fallback based on the tag. */
+		emit_a64_mov_i(1, tmp2, insn->off, ctx);
+		emit(M64_ADD(tmp, base, tmp2), ctx);
+		if (BPF_CLASS(insn->code) == BPF_ST) {
+			emit_a64_mov_i(1, tmp2, insn->imm, ctx);
+			value = tmp2;
+		}
+		emit(M64_MEM(load, ilog2(size), value, tmp), ctx);
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
