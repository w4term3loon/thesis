+static int prepare_array_caps(struct jit_ctx *ctx)
+{
+	const struct bpf_prog *prog = ctx->prog;
+	const struct bpf_prog_aux *aux = prog->aux;
+	const struct bpf_map *map;
+	const struct bpf_array *array;
+	void * __capability parent;
+	unsigned long mask;
+	u32 i, counts[BPF_OBJECT_UNSUPPORTED] = {};
+
+	if (!aux->array_caps)
+		return 0;
+	/* The gateway's private context and saved capabilities must not be
+	 * reachable through Leaf's vmalloc RDDC (including via kernel stacks).
+	 */
+	if (IS_ENABLED(CONFIG_VMAP_STACK) || prog->is_func || prog->blinded ||
+	    prog->type != BPF_PROG_TYPE_SOCKET_FILTER || aux->used_map_cnt != 1 ||
+	    !aux->object_meta || aux->object_meta_len != prog->len)
+		goto unsupported_profile;
+	map = aux->used_maps[0];
+	if (map->map_type != BPF_MAP_TYPE_ARRAY || map->record ||
+	    !(map->map_flags & BPF_F_MMAPABLE))
+		goto unsupported_profile;
+	array = container_of(map, struct bpf_array, map);
+	parent = bpf_array_storage_cap(map);
+	mask = cheri_representable_alignment_mask(map->value_size);
+	/* Sufficient alignment for every element, not merely the parent. */
+	if (!cheri_tag_get(parent) ||
+	    cheri_base_get(parent) != (unsigned long)array->value ||
+	    cheri_length_get(parent) != (u64)map->max_entries * array->elem_size ||
+	    cheri_representable_length(map->value_size) != map->value_size ||
+	    (((unsigned long)array->value | array->elem_size) & ~mask))
+		goto unsupported_profile;
+
+	for (i = 0; i < prog->len; i++) {
+		const struct bpf_insn *insn = &prog->insnsi[i];
+		const struct bpf_object_meta *meta = &aux->object_meta[i];
+		u8 class = BPF_CLASS(insn->code), op = BPF_OP(insn->code);
+
+		/* No helper ABI, loops, atomics, or subprograms in this first path. */
+		if (class == BPF_JMP32 ||
+		    (class == BPF_JMP && (op == BPF_CALL || op == BPF_TAIL_CALL ||
+					 (op != BPF_EXIT && insn->off < 0))) ||
+		    (class == BPF_STX && BPF_MODE(insn->code) == BPF_ATOMIC))
+			goto unsupported_insn;
+		switch (meta->kind) {
+		case BPF_OBJECT_NONE:
+			continue;
+		case BPF_OBJECT_ARRAY_VALUE_RESULT:
+			if (meta->map_index ||
+			    insn->code != (BPF_ALU64 | BPF_ADD | BPF_X) ||
+			    insn->dst_reg != BPF_REG_0 || insn->src_reg != BPF_REG_1 ||
+			    insn->off || insn->imm)
+				goto unsupported_insn;
+			break;
+		case BPF_OBJECT_ARRAY_COPY:
+			if (insn->code != (BPF_ALU64 | BPF_MOV | BPF_X) || insn->off)
+				goto unsupported_insn;
+			break;
+		case BPF_OBJECT_ARRAY_OFFSET:
+			if (insn->code != (BPF_ALU64 | BPF_ADD | BPF_K) &&
+			    insn->code != (BPF_ALU64 | BPF_SUB | BPF_K))
+				goto unsupported_insn;
+			break;
+		case BPF_OBJECT_ARRAY_LOAD:
+			if (class != BPF_LDX || BPF_MODE(insn->code) != BPF_MEM)
+				goto unsupported_insn;
+			break;
+		case BPF_OBJECT_ARRAY_STORE:
+			if ((class != BPF_ST && class != BPF_STX) ||
+			    BPF_MODE(insn->code) != BPF_MEM)
+				goto unsupported_insn;
+			break;
+		default:
+			goto unsupported_insn;
+		}
+		counts[meta->kind]++;
+	}
+	if (!counts[BPF_OBJECT_ARRAY_VALUE_RESULT])
+		goto unsupported_profile;
+	ctx->array_map = map;
+	pr_info("BPF_ARRAY_CAP stage=jit prog=%s lookups=%u copies=%u offsets=%u loads=%u stores=%u\n",
+		aux->name, counts[BPF_OBJECT_ARRAY_VALUE_RESULT],
+		counts[BPF_OBJECT_ARRAY_COPY], counts[BPF_OBJECT_ARRAY_OFFSET],
+		counts[BPF_OBJECT_ARRAY_LOAD], counts[BPF_OBJECT_ARRAY_STORE]);
+	return 0;
+
+unsupported_insn:
+	pr_err("BPF_ARRAY_CAP prog=%s unsupported_pc=%u kind=%u\n",
+	       aux->name, i, aux->object_meta[i].kind);
+	return -EOPNOTSUPP;
+unsupported_profile:
+	pr_err("BPF_ARRAY_CAP prog=%s unsupported_profile\n", aux->name);
+	return -EOPNOTSUPP;
+}
