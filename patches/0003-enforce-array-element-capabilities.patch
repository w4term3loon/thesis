+
+/* Called only by the executive-mode gate, with its kernel-held map reference. */
+void * __capability bpf_array_value_cap(const struct bpf_map *map,
+				      unsigned long address)
+{
+	const struct bpf_array *array = container_of(map, struct bpf_array, map);
+	void * __capability parent = bpf_array_storage_cap(map);
+	void * __capability child;
+	unsigned long base = cheri_base_get(parent), offset;
+	cheri_perms_t perms;
+
+	if (!cheri_tag_get(parent) || address < base || !array->elem_size)
+		return NULL;
+	offset = address - base;
+	if (offset >= cheri_length_get(parent) || offset % array->elem_size ||
+	    offset / array->elem_size >= map->max_entries)
+		return NULL;
+	child = cheri_address_set(parent, address);
+	child = cheri_bounds_set_exact(child, map->value_size);
+	if (!cheri_tag_get(child) || cheri_base_get(child) != address ||
+	    cheri_length_get(child) != map->value_size)
+		return NULL;
+	perms = cheri_perms_get(child);
+	pr_info("BPF_ARRAY_VALUE stage=runtime index=%lu tag=%d base_matches=1 length=%llu parent_length=%llu read=%d write=%d exec=%d load_cap=%d store_cap=%d\n",
+		offset / array->elem_size, cheri_tag_get(child),
+		(u64)cheri_length_get(child), (u64)cheri_length_get(parent),
+		!!(perms & CHERI_PERM_LOAD), !!(perms & CHERI_PERM_STORE),
+		!!(perms & CHERI_PERM_EXECUTE), !!(perms & CHERI_PERM_LOAD_CAP),
+		!!(perms & CHERI_PERM_STORE_CAP));
+	return child;
+}
 #else
 static void array_map_init_authority(struct bpf_array *array)
 {
