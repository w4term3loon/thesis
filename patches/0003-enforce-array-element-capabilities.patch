+static bool is_array_value_reg(const struct bpf_reg_state *reg)
+{
+	return base_type(reg->type) == PTR_TO_MAP_VALUE && reg->map_ptr &&
+	       reg->map_ptr->map_type == BPF_MAP_TYPE_ARRAY;
+}
+
+/* Retain use semantics, never the verifier's numerical pointer bounds. */
+static void record_array_value_use(struct bpf_verifier_env *env,
+				   const struct bpf_insn *insn,
+				   const struct bpf_reg_state *regs)
+{
+	struct bpf_insn_aux_data *aux = &env->insn_aux_data[env->insn_idx];
+	u8 class = BPF_CLASS(insn->code), op = BPF_OP(insn->code);
+	u8 kind = BPF_OBJECT_NONE;
+	bool dst, src;
+	int r;
+
+	if (!IS_ENABLED(CONFIG_ARM64_MORELLO) ||
+	    insn->dst_reg >= MAX_BPF_REG || insn->src_reg >= MAX_BPF_REG)
+		return;
+	dst = is_array_value_reg(&regs[insn->dst_reg]);
+	src = is_array_value_reg(&regs[insn->src_reg]);
+	if (class == BPF_ALU || class == BPF_ALU64) {
+		if (op == BPF_MOV) {
+			if (BPF_SRC(insn->code) == BPF_X && src)
+				kind = class == BPF_ALU64 && !insn->off ?
+					BPF_OBJECT_ARRAY_COPY : BPF_OBJECT_UNSUPPORTED;
+		} else if (dst || (BPF_SRC(insn->code) == BPF_X && src)) {
+			kind = dst && class == BPF_ALU64 &&
+			       BPF_SRC(insn->code) == BPF_K &&
+			       (op == BPF_ADD || op == BPF_SUB) ?
+				BPF_OBJECT_ARRAY_OFFSET : BPF_OBJECT_UNSUPPORTED;
+		}
+	} else if (class == BPF_LDX) {
+		if (src && BPF_MODE(insn->code) == BPF_MEM)
+			kind = BPF_OBJECT_ARRAY_LOAD;
+		else if (regs[insn->src_reg].type != PTR_TO_STACK)
+			kind = BPF_OBJECT_UNSUPPORTED;
+	} else if (class == BPF_ST || class == BPF_STX) {
+		if (dst && BPF_MODE(insn->code) == BPF_MEM)
+			kind = BPF_OBJECT_ARRAY_STORE;
+		else if (regs[insn->dst_reg].type != PTR_TO_STACK)
+			kind = BPF_OBJECT_UNSUPPORTED;
+		/* Eight-byte BPF spills cannot preserve a Morello capability. */
+		if (class == BPF_STX && src)
+			kind = BPF_OBJECT_UNSUPPORTED;
+	} else if (class == BPF_JMP || class == BPF_JMP32) {
+		if (op == BPF_CALL) {
+			/* Includes lookup keys supplied through an array-value pointer. */
+			for (r = BPF_REG_1; r <= BPF_REG_5; r++)
+				if (is_array_value_reg(&regs[r]))
+					kind = BPF_OBJECT_UNSUPPORTED;
+		} else if (op != BPF_JA && (dst || (BPF_SRC(insn->code) == BPF_X && src))) {
+			if (class != BPF_JMP || BPF_SRC(insn->code) != BPF_K ||
+			    insn->imm || (op != BPF_JEQ && op != BPF_JNE))
+				kind = BPF_OBJECT_UNSUPPORTED;
+		}
+	} else if (insn->code == (BPF_LD | BPF_DW | BPF_IMM) &&
+		   (insn->src_reg == BPF_PSEUDO_MAP_VALUE ||
+		    insn->src_reg == BPF_PSEUDO_MAP_IDX_VALUE)) {
+		kind = BPF_OBJECT_UNSUPPORTED;
+	}
+	/* Do not specialize an instruction whose meaning differs across paths. */
+	if (aux->object_meta_seen && aux->object_meta.kind != kind)
+		kind = BPF_OBJECT_UNSUPPORTED;
