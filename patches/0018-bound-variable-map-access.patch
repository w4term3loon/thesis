+			if (BPF_SRC(insn->code) == BPF_X)
+				pr_info("BPF_POINTER_RANGE prog=%s pc=%u op=%s min_off=%u max_off=%u\n",
+					aux->name, i, op == BPF_ADD ? "add" : "sub",
