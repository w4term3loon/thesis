 				goto unsupported_insn;
 			break;
 		case BPF_OBJECT_MAP_LOAD:
@@ -2046,17 +2069,24 @@ static int prepare_object_caps(struct jit_ctx *ctx)
 		}
 		if (meta->kind == BPF_OBJECT_MAP_LOAD ||
