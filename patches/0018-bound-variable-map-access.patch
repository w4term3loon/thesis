@@ -1008,10 +1008,18 @@ static int emit_object_cap_insn(const struct bpf_insn *insn,
 		return 0;
 	case BPF_OBJECT_MAP_OFFSET:
 	case BPF_OBJECT_STACK_OFFSET:
-		offset = insn->imm;
-		if (BPF_OP(insn->code) == BPF_SUB)
-			offset = -offset;
-		emit_a64_mov_i64(tmp, offset, ctx);
+		if (BPF_SRC(insn->code) == BPF_X && BPF_OP(insn->code) == BPF_ADD) {
+			emit(M64_ADD(dst, dst, src), ctx);
+			return 0;
+		}
+		if (BPF_SRC(insn->code) == BPF_X) {
+			emit(A64_NEG(1, tmp, src), ctx);
+		} else {
+			offset = insn->imm;
+			if (BPF_OP(insn->code) == BPF_SUB)
+				offset = -offset;
+			emit_a64_mov_i64(tmp, offset, ctx);
+		}
 		emit(M64_ADD(dst, dst, tmp), ctx);
 		return 0;
 	case BPF_OBJECT_MAP_LOAD:
@@ -1030,7 +1038,9 @@ static int emit_object_cap_insn(const struct bpf_insn *insn,
 					     meta->access_off, ctx);
 		emit(A64_ADD(1, tmp2, tmp2, tmp3), ctx);
 		emit(M64_SCVALUE(tmp, base, tmp2), ctx);
-		emit_a64_mov_i(1, tmp3, meta->access_size, ctx);
+		emit_a64_mov_i(1, tmp3, stack ? meta->access_size :
+				   meta->access_max_off - meta->access_off + meta->access_size,
+				   ctx);
 		emit(M64_SCBNDSE(tmp, tmp, tmp3), ctx);
 		/* Direction is already encoded in the verified LOAD/STORE kind. */
 		emit_a64_mov_i64(tmp3, ~(u64)(load ? CHERI_PERM_LOAD : CHERI_PERM_STORE), ctx);
@@ -1978,7 +1988,7 @@ static int prepare_object_caps(struct jit_ctx *ctx)
 		switch (meta->kind) {
 		case BPF_OBJECT_NATIVE:
 			if (!cap_native_insn(insn) || meta->map_index ||
-			    meta->access_off || meta->access_size)
+			    meta->access_off || meta->access_max_off || meta->access_size)
 				goto unsupported_insn;
 			if (insn->code == (BPF_LD | BPF_IMM | BPF_DW)) {
 				/* The second slot is data, not an unclassified instruction. */
@@ -2007,6 +2017,7 @@ static int prepare_object_caps(struct jit_ctx *ctx)
 		case BPF_OBJECT_RING_SUBMIT:
 		case BPF_OBJECT_RING_DISCARD:
 			if (!ring || meta->map_index || meta->access_off ||
+			    meta->access_max_off ||
 			    meta->access_size != (meta->kind == BPF_OBJECT_RING_RESERVE ? BPF_CAP_RINGBUF_SIZE : 0) ||
 			    insn->code != (BPF_JMP | BPF_CALL) ||
 			    insn->dst_reg || insn->src_reg || insn->off ||
@@ -2021,13 +2032,25 @@ static int prepare_object_caps(struct jit_ctx *ctx)
 				goto unsupported_insn;
 			break;
 		case BPF_OBJECT_MAP_OFFSET:
-		case BPF_OBJECT_STACK_OFFSET:
 			if (insn->code != (BPF_ALU64 | BPF_ADD | BPF_K) &&
-			    insn->code != (BPF_ALU64 | BPF_SUB | BPF_K))
+			    insn->code != (BPF_ALU64 | BPF_SUB | BPF_K) &&
+			    insn->code != (BPF_ALU64 | BPF_ADD | BPF_X) &&
