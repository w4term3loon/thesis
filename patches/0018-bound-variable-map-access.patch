+			break;
+		case BPF_OBJECT_STACK_OFFSET:
+			if ((insn->code != (BPF_ALU64 | BPF_ADD | BPF_K) &&
+			     insn->code != (BPF_ALU64 | BPF_SUB | BPF_K)) ||
