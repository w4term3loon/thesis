diff --git a/include/linux/bpf.h b/include/linux/bpf.h
index 906752cf6..00de6f767 100644
--- a/include/linux/bpf.h
+++ b/include/linux/bpf.h
@@ -1428,7 +1428,8 @@ enum bpf_object_kind {
 /* Object identity and exact access contracts, never parent authority. */
 struct bpf_object_meta {
 	u32 map_index;
-	u32 access_off; /* Element offset, or positive distance below BPF FP. */
+	u32 access_off; /* Minimum map offset, or distance below BPF FP. */
+	u32 access_max_off; /* Maximum map offset; zero for stack contracts. */
 	u8 kind;
 	u8 access_size;
 };
diff --git a/kernel/bpf/verifier.c b/kernel/bpf/verifier.c
index 183134654..1821d1a64 100644
--- a/kernel/bpf/verifier.c
+++ b/kernel/bpf/verifier.c
@@ -17423,7 +17423,24 @@ static bool is_map_value_reg(const struct bpf_reg_state *reg)
 		reg->map_ptr->map_type == BPF_MAP_TYPE_HASH));
 }
 
-/* Retain use semantics and constant object-relative access contracts. */
+static bool map_object_offset_range(const struct bpf_reg_state *reg, s64 add,
+				    u32 limit, u32 *min_off, u32 *max_off)
+{
+	s64 fixed, min, max;
+
+	/* Match the verifier's signed floor and unsigned ceiling checks. */
+	if (reg->umax_value >= BPF_MAX_VAR_OFF ||
+	    check_add_overflow((s64)reg->off, add, &fixed) ||
+	    check_add_overflow(fixed, reg->smin_value, &min) ||
+	    check_add_overflow(fixed, (s64)reg->umax_value, &max) ||
+	    min < 0 || max < min || max > limit)
+		return false;
+	*min_off = min;
+	*max_off = max;
+	return true;
+}
+
+/* Retain use semantics and bounded object-relative access contracts. */
 static void record_object_use(struct bpf_verifier_env *env,
 				   const struct bpf_insn *insn,
 				   const struct bpf_reg_state *regs)
@@ -17431,7 +17448,7 @@ static void record_object_use(struct bpf_verifier_env *env,
 	struct bpf_insn_aux_data *aux = &env->insn_aux_data[env->insn_idx];
 	u8 class = BPF_CLASS(insn->code), op = BPF_OP(insn->code);
 	u8 kind = BPF_OBJECT_NATIVE;
-	u32 access_off = 0, map_index = 0;
+	u32 access_off = 0, access_max_off = 0, map_index = 0;
 	u8 access_size = 0;
 	bool dst, src, dst_stack, src_stack;
 	int r;
@@ -17452,8 +17469,9 @@ static void record_object_use(struct bpf_verifier_env *env,
 			}
 		} else if (dst || (BPF_SRC(insn->code) == BPF_X && src)) {
 			kind = dst_stack ? BPF_OBJECT_STACK_OFFSET : BPF_OBJECT_MAP_OFFSET;
-			if (!dst || class != BPF_ALU64 || BPF_SRC(insn->code) != BPF_K ||
-			    (op != BPF_ADD && op != BPF_SUB))
+			if (!dst || class != BPF_ALU64 ||
+			    (op != BPF_ADD && op != BPF_SUB) ||
+			    (dst_stack && BPF_SRC(insn->code) != BPF_K))
 				kind = BPF_OBJECT_UNSUPPORTED;
 		}
 	} else if (class == BPF_LDX) {
@@ -17519,16 +17537,14 @@ static void record_object_use(struct bpf_verifier_env *env,
 						      insn->src_reg : insn->dst_reg];
 		int size = bpf_size_to_bytes(BPF_SIZE(insn->code));
 		u32 limit = is_ringbuf_value_reg(reg) ? reg->mem_size : reg->map_ptr->value_size;
-		s64 off;
 
 		/* Include prior pointer arithmetic, not just insn->off. */
-		if (!tnum_is_const(reg->var_off) || size <= 0 ||
-		    check_add_overflow((s64)reg->var_off.value, (s64)reg->off, &off) ||
-		    check_add_overflow(off, (s64)insn->off, &off) || off < 0 ||
-		    off > limit || size > limit - off) {
+		if (size <= 0 ||
+		    !map_object_offset_range(reg, insn->off, limit,
+					     &access_off, &access_max_off) ||
+		    size > limit - access_max_off) {
 			kind = BPF_OBJECT_UNSUPPORTED;
 		} else {
-			access_off = off;
 			access_size = size;
 		}
 	}
@@ -17551,7 +17567,45 @@ static void record_object_use(struct bpf_verifier_env *env,
 			access_size = size;
 		}
 	}
-	if (kind == BPF_OBJECT_MAP_OFFSET || kind == BPF_OBJECT_STACK_OFFSET) {
+	if (kind == BPF_OBJECT_MAP_OFFSET) {
+		const struct bpf_reg_state *reg = &regs[insn->dst_reg];
+		u32 limit = is_ringbuf_value_reg(reg) ? reg->mem_size : reg->map_ptr->value_size;
+		s64 min = 0, max = 0, delta_min, delta_max;
+
+		if (!map_object_offset_range(reg, 0, limit, &access_off,
+					     &access_max_off)) {
+			kind = BPF_OBJECT_UNSUPPORTED;
+		} else {
+			if (BPF_SRC(insn->code) == BPF_K) {
+				delta_min = delta_max = insn->imm;
+			} else {
+				const struct bpf_reg_state *scalar = &regs[insn->src_reg];
+
+				if (scalar->type != SCALAR_VALUE ||
+				    scalar->smin_value > scalar->smax_value ||
+				    scalar->smin_value < -(s64)limit ||
+				    scalar->smax_value > limit) {
+					kind = BPF_OBJECT_UNSUPPORTED;
+					goto record_meta;
+				}
+				delta_min = scalar->smin_value;
+				delta_max = scalar->smax_value;
+			}
+			if ((op == BPF_ADD &&
+			     (check_add_overflow((s64)access_off, delta_min, &min) ||
+			      check_add_overflow((s64)access_max_off, delta_max, &max))) ||
+			    (op == BPF_SUB &&
+			     (check_sub_overflow((s64)access_off, delta_max, &min) ||
+			      check_sub_overflow((s64)access_max_off, delta_min, &max))) ||
+			    min < 0 || max < min || max > limit) {
+				kind = BPF_OBJECT_UNSUPPORTED;
+			} else {
+				access_off = min;
+				access_max_off = max;
+			}
+		}
+	}
+	if (kind == BPF_OBJECT_STACK_OFFSET) {
 		const struct bpf_reg_state *reg = &regs[insn->dst_reg];
 		s64 off, delta = insn->imm;
 
@@ -17561,25 +17615,27 @@ static void record_object_use(struct bpf_verifier_env *env,
 		if (!tnum_is_const(reg->var_off) ||
 		    check_add_overflow((s64)reg->var_off.value, (s64)reg->off, &off) ||
 		    check_add_overflow(off, delta, &off) ||
-		    (dst_stack ? off > 0 || off < -MAX_BPF_STACK :
-				 off < 0 || off > U32_MAX)) {
+		    off > 0 || off < -MAX_BPF_STACK) {
 			kind = BPF_OBJECT_UNSUPPORTED;
 		} else {
 			/* OFFSET records the resulting cursor; JIT checks final size. */
-			access_off = dst_stack ? -off : off;
+			access_off = -off;
 		}
 	}
 
+record_meta:
 	/* A single contract must hold on every explored path; never widen it. */
 	if (aux->object_meta_seen &&
 	    (aux->object_meta.kind != kind ||
 	     aux->object_meta.map_index != map_index ||
 	     aux->object_meta.access_off != access_off ||
+	     aux->object_meta.access_max_off != access_max_off ||
 	     aux->object_meta.access_size != access_size))
 		kind = BPF_OBJECT_UNSUPPORTED;
 	aux->object_meta.kind = kind;
 	aux->object_meta.map_index = map_index;
 	aux->object_meta.access_off = access_off;
+	aux->object_meta.access_max_off = access_max_off;
 	aux->object_meta.access_size = access_size;
 	aux->object_meta_seen = true;
 }
@@ -19640,8 +19696,9 @@ static int publish_object_meta(struct bpf_verifier_env *env)
 				prog->aux->name, i, meta[i].map_index);
 		if (meta[i].kind == BPF_OBJECT_MAP_LOAD ||
 		    meta[i].kind == BPF_OBJECT_MAP_STORE)
-			pr_debug("BPF_ACCESS_META stage=verifier prog=%s pc=%u element_off=%u insn_off=%d size=%u\n",
+			pr_debug("BPF_ACCESS_META stage=verifier prog=%s pc=%u min_off=%u max_off=%u insn_off=%d size=%u\n",
 				prog->aux->name, i, meta[i].access_off,
+				meta[i].access_max_off,
 				prog->insnsi[i].off, meta[i].access_size);
 	}
 	prog->aux->object_meta = meta;

