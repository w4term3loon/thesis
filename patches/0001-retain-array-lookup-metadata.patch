Subject: [PATCH 1] bpf: retain array lookup identity for JIT inspection

Base: dfcb2dc498ff214dc8b3d8117ef7e8c7e7901152 (Leaf RFC)

Retain the used-map index and a semantic marker on the successful value
producer inserted by array_map_gen_lookup(). Carry this metadata through
verifier rewrites and publish it only after the final instruction layout
and retained map list are available.

At arm64 JIT entry, report the marker and read value_size and program
access permissions from the retained map object. Free the sidecar with
the program.

This is diagnostic only: it neither constructs capabilities nor changes
verification decisions or native instruction emission. Metadata allocation
failure only disables reporting.

Scope: ordinary ARRAY lookup inlining, no special BTF fields, one BPF
subprogram, and constant blinding disabled. Subprogram JIT and blinding
require separate metadata remapping and are deliberately not reported.
A replaced producer loses its marker instead of inheriting stale semantics.

---
diff --git a/arch/arm64/net/bpf_jit_comp.c b/arch/arm64/net/bpf_jit_comp.c
index 87e041638..56ed27b0d 100644
--- a/arch/arm64/net/bpf_jit_comp.c
+++ b/arch/arm64/net/bpf_jit_comp.c
@@ -1640,6 +1640,40 @@ void *bpf_jit_alloc_stack()
 	return kasan_reset_tag(sp);
 }
 
+/* Diagnostic consumer only: this does not change native code emission. */
+static void inspect_object_meta(const struct bpf_prog *prog)
+{
+	const struct bpf_prog_aux *aux = prog->aux;
+	const struct bpf_object_meta *meta;
+	const struct bpf_insn *insn;
+	struct bpf_map *map;
+	u32 i, access;
+
+	if (!aux->object_meta || prog->is_func || prog->blinded ||
+	    aux->object_meta_len != prog->len)
+		return;
+
+	for (i = 0; i < prog->len; i++) {
+		meta = &aux->object_meta[i];
+		if (meta->kind != BPF_OBJECT_ARRAY_VALUE_RESULT)
+			continue;
+		if (!aux->used_maps || meta->map_index >= aux->used_map_cnt)
+			return;
+		map = aux->used_maps[meta->map_index];
+		insn = &prog->insnsi[i];
+		if (map->map_type != BPF_MAP_TYPE_ARRAY || map->record ||
+		    insn->code != (BPF_ALU64 | BPF_ADD | BPF_X) ||
+		    insn->dst_reg != BPF_REG_0 || insn->src_reg != BPF_REG_1 ||
+		    insn->off || insn->imm)
+			return;
+		access = bpf_map_flags_to_cap(map);
+		pr_info("BPF_OBJECT_META stage=jit prog=%s pc=%u kind=array_value_result dst=r%u map_index=%u map_type=%u value_size=%u map_flags=%#x read=%d write=%d\n",
+			aux->name, i, insn->dst_reg, meta->map_index,
+			map->map_type, map->value_size, map->map_flags,
+			!!(access & BPF_MAP_CAN_READ), !!(access & BPF_MAP_CAN_WRITE));
+	}
+}
+
 struct bpf_prog *bpf_int_jit_compile(struct bpf_prog *prog)
 {
 	int prog_size, extable_size, extable_align, extable_offset;
@@ -1666,6 +1700,8 @@ struct bpf_prog *bpf_int_jit_compile(struct bpf_prog *prog)
 		prog = tmp;
 	}
 
+	inspect_object_meta(prog);
+
 	jit_data = prog->aux->jit_data;
 	if (!jit_data) {
 		jit_data = kzalloc(sizeof(*jit_data), GFP_KERNEL);
diff --git a/include/linux/bpf.h b/include/linux/bpf.h
index 9471b3e02..03d4b573e 100644
--- a/include/linux/bpf.h
+++ b/include/linux/bpf.h
@@ -1402,7 +1402,20 @@ struct btf_mod_pair {
 
 struct bpf_kfunc_desc_tab;
 
+enum bpf_object_kind {
+	BPF_OBJECT_NONE,
+	BPF_OBJECT_ARRAY_VALUE_RESULT,
+};
+
+/* Semantic association only; bounds and permissions remain map properties. */
+struct bpf_object_meta {
+	u32 map_index;
+	u8 kind;
+};
+
 struct bpf_prog_aux {
+	struct bpf_object_meta *object_meta;
+	u32 object_meta_len;
 	atomic64_t refcnt;
 	u32 used_map_cnt;
 	u32 used_btf_cnt;
diff --git a/include/linux/bpf_verifier.h b/include/linux/bpf_verifier.h
index aa4d19d0b..f90bb77b5 100644
--- a/include/linux/bpf_verifier.h
+++ b/include/linux/bpf_verifier.h
@@ -474,6 +474,7 @@ struct bpf_loop_inline_state {
 					 BPF_ALU_SANITIZE_DST)
 
 struct bpf_insn_aux_data {
+	struct bpf_object_meta object_meta;
 	union {
 		enum bpf_reg_type ptr_type;	/* pointer type for load/store insns */
 		unsigned long map_ptr_state;	/* pointer/poison value for maps */
diff --git a/kernel/bpf/core.c b/kernel/bpf/core.c
index 509a70e6c..7ed28e497 100644
--- a/kernel/bpf/core.c
+++ b/kernel/bpf/core.c
@@ -267,6 +267,7 @@ struct bpf_prog *bpf_prog_realloc(struct bpf_prog *fp_old, unsigned int size,
 void __bpf_prog_free(struct bpf_prog *fp)
 {
 	if (fp->aux) {
+		kvfree(fp->aux->object_meta);
 		mutex_destroy(&fp->aux->used_maps_mutex);
 		mutex_destroy(&fp->aux->dst_mutex);
 		kfree(fp->aux->poke_tab);
diff --git a/kernel/bpf/verifier.c b/kernel/bpf/verifier.c
index dd8dd477e..66cc36198 100644
--- a/kernel/bpf/verifier.c
+++ b/kernel/bpf/verifier.c
@@ -18262,6 +18262,8 @@ static void adjust_insn_aux_data(struct bpf_verifier_env *env,
 	 * original insn at old prog.
 	 */
 	old_data[off].zext_dst = insn_has_def32(env, insn + off + cnt - 1);
+	/* Replacement does not establish the new instruction's semantics. */
+	old_data[off].object_meta.kind = BPF_OBJECT_NONE;
 
 	if (cnt == 1)
 		return;
@@ -19362,6 +19364,67 @@ static int add_hidden_subprog(struct bpf_verifier_env *env, struct bpf_insn *pat
 	return 0;
 }
 
+static void record_array_lookup_result(struct bpf_verifier_env *env,
+				       struct bpf_map *map, u32 off, u32 cnt)
+{
+	struct bpf_object_meta *meta;
+	const struct bpf_insn *insn;
+	u32 map_index, pc;
+
+	if (env->subprog_cnt != 1 || env->prog->blinding_requested ||
+	    map->map_type != BPF_MAP_TYPE_ARRAY || map->record || cnt < 3)
+		return;
+
+	/* The pinned array generator ends with ADD r0,r1; JA; MOV r0,0. */
+	pc = off + cnt - 3;
+	insn = &env->prog->insnsi[pc];
+	if (insn->code != (BPF_ALU64 | BPF_ADD | BPF_X) ||
+	    insn->dst_reg != BPF_REG_0 || insn->src_reg != BPF_REG_1 ||
+	    insn->off || insn->imm)
+		return;
+
+	for (map_index = 0; map_index < env->used_map_cnt; map_index++)
+		if (env->used_maps[map_index] == map)
+			break;
+	if (map_index == env->used_map_cnt)
+		return;
+
+	meta = &env->insn_aux_data[pc].object_meta;
+	meta->kind = BPF_OBJECT_ARRAY_VALUE_RESULT;
+	meta->map_index = map_index;
+}
+
+static void publish_object_meta(struct bpf_verifier_env *env)
+{
+	struct bpf_prog *prog = env->prog;
+	struct bpf_object_meta *meta;
+	u32 i, count = 0;
+
+	/* Subprogram JIT and constant blinding need their own metadata handling. */
+	if (env->subprog_cnt != 1 || prog->blinding_requested)
+		return;
+
+	for (i = 0; i < prog->len; i++)
+		count += env->insn_aux_data[i].object_meta.kind != BPF_OBJECT_NONE;
+	if (!count)
+		return;
+
+	meta = kvcalloc(prog->len, sizeof(*meta), GFP_KERNEL);
+	if (!meta) {
+		pr_warn("BPF_OBJECT_META prog=%s unavailable=allocation_failed\n",
+			prog->aux->name);
+		return;
+	}
+	for (i = 0; i < prog->len; i++) {
+		meta[i] = env->insn_aux_data[i].object_meta;
+		if (meta[i].kind == BPF_OBJECT_ARRAY_VALUE_RESULT)
+			pr_info("BPF_OBJECT_META stage=verifier prog=%s pc=%u kind=array_value_result map_index=%u\n",
+				prog->aux->name, i, meta[i].map_index);
+	}
+	prog->aux->object_meta = meta;
+	prog->aux->object_meta_len = prog->len;
+}
+
 /* Do various post-verification rewrites in a single program pass.
  * These rewrites simplify JIT and interpreter implementations.
  */
@@ -19723,8 +19786,9 @@ static int do_misc_fixups(struct bpf_verifier_env *env)
 				if (!new_prog)
 					return -ENOMEM;
 
-				delta    += cnt - 1;
 				env->prog = prog = new_prog;
+				record_array_lookup_result(env, map_ptr, i + delta, cnt);
+				delta    += cnt - 1;
 				insn      = new_prog->insnsi + i + delta;
 				continue;
 			}
@@ -20968,6 +21032,7 @@ int bpf_check(struct bpf_prog **prog, union bpf_attr *attr, bpfptr_t uattr, __u3
 	}
 
 	adjust_btf_func(env);
+	publish_object_meta(env);
 
 err_release_maps:
 	if (!env->prog->aux->used_maps)
